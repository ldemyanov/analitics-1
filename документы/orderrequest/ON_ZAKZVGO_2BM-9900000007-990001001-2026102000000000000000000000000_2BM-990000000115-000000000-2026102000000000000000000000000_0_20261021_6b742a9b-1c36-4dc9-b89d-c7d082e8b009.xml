          -->
          <ИдРекСост>
            <!--
              ИННФЛ: ИНН физического лица, в том числе индивидуального предпринимателя.
            -->
            <ИННФЛ>990000000362</ИННФЛ>
          </ИдРекСост>
        </ДогУслПрвз>
        <!--
          Пункт: Пункты погрузки и выгрузки.
            Погр="1": Пункт погрузки.

            Выгр="2": Пункт выгрузки.

            КолГрМест="24": Количество грузовых мест.
        -->
        <Пункт Погр="1" Выгр="2" КолГрМест="24"/>
      </ОпГруз>
      <!--
        ПарТСПрвз: Параметры транспортного средства, необходимые для осуществления перевозки груза.
          Тип="Изотермический фургон": Тип.

          Грузопод="3.50": Грузоподъемность, в тоннах.

          Вместим="12.00": Вместимость, в кубических метрах.
      -->
      <ПарТСПрвз Тип="Изотермический фургон" Грузопод="3.50" Вместим="12.00"/>
    </СодИнфГО>
    <!--
      ПодпИнфГО: Сведения о лице, подписывающем файл обмена информации грузоотправителя.
        СпосПодтПолном="1": полномочия подтверждаются данными электронной подписи.
        СпосПодтПолном="2": машиночитаемая доверенность передается в каждом пакете документов, если законодательством не
          предусмотрено иное.
        СпосПодтПолном="3": машиночитаемая доверенность хранится в информационной системе, сведения для запроса указаны в
          СвДоверЭл.
        СпосПодтПолном="4": машиночитаемая доверенность хранится в информационной системе, сведения для запроса передаются
          отдельно.
        СпосПодтПолном="5": полномочия подтверждает бумажная доверенность, необходим СвДоверБум.
        СпосПодтПолном="6": иной способ подтверждения полномочий.

        Должн="Индивидуальный предприниматель": Должность.
    -->
    <ПодпИнфГО СпосПодтПолном="1" Должн="Индивидуальный предприниматель">
      <ФИО Фамилия="Воронов" Имя="Алексей" Отчество="Сергеевич"/>
    </ПодпИнфГО>
  </Документ>
</Файл>
